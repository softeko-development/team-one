# Postgres running via docker-compose.yml (service `postgres`).
# Credentials match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB there.
# Loaded by Prisma through `import "dotenv/config"` in prisma.config.ts,
# and by Next.js automatically at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interview_team_project?schema=public"
